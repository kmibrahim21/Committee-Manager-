{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "lib/*": [
        "./lib/*"
      ],
      "supabase": [
        "./src/supabase"
      ],
      "types": [
        "./src/types"
      ],
      "translations": [
        "./src/translations"
      ],
      "components/*": [
        "./src/components/*"
      ],
      "pages/*": [
        "./src/pages/*"
      ],
      "services/*": [
        "./src/services/*"
      ],
      "utils/*": [
        "./src/utils/*"
      ],
      "hooks/*": [
        "./src/hooks/*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
